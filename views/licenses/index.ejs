<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body>
  <%- include('../partials/navbar') %>

  <div class="container-fluid">
    <div class="row">
      <%- include('../partials/sidebar') %>

      <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 main-content">
        <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
          <h1 class="h2"><i class="bi bi-key"></i> Licenses</h1>
          <div class="btn-toolbar mb-2 mb-md-0">
            <a href="/licenses/create" class="btn btn-sm btn-primary">
              <i class="bi bi-key-fill"></i> Generate License
            </a>
          </div>
        </div>

        <div class="card">
          <div class="card-body">
            <div class="table-responsive">
              <table id="licensesTable" class="table table-striped table-hover">
                <thead>
                  <tr>
                    <th>ID</th>
                    <th>License Key</th>
                    <th>Product</th>
                    <th>Customer</th>
                    <th>Type</th>
                    <th>Status</th>
                    <th>Activations</th>
                    <th>Expiry Date</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% licenses.forEach(license => { %>
                    <tr>
                      <td><%= license.id %></td>
                      <td><code class="license-key"><%= license.license_key %></code></td>
                      <td><%= license.product_name %></td>
                      <td><%= license.customer_name %></td>
                      <td><span class="badge bg-secondary"><%= license.type %></span></td>
                      <td>
                        <span class="badge bg-<%= license.status === 'active' ? 'success' : license.status === 'expired' ? 'danger' : 'secondary' %>">
                          <%= license.status %>
                        </span>
                      </td>
                      <td><%= license.current_activations %>/<%= license.max_activations %></td>
                      <td><%= new Date(license.expiry_date).toLocaleDateString() %></td>
                      <td>
                        <div class="btn-group btn-group-sm">
                          <a href="/licenses/<%= license.id %>" class="btn btn-outline-primary" title="View">
                            <i class="bi bi-eye"></i>
                          </a>
                          <button type="button" class="btn btn-outline-secondary" onclick="copyLicense('<%= license.license_key %>')" title="Copy">
                            <i class="bi bi-clipboard"></i>
                          </button>
                          <a href="/licenses/<%= license.id %>/edit" class="btn btn-outline-info" title="Edit">
                            <i class="bi bi-pencil"></i>
                          </a>
                        </div>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </main>
    </div>
  </div>

  <%- include('../partials/footer') %>

  <script>
    $(document).ready(function() {
      $('#licensesTable').DataTable({
        order: [[0, 'desc']],
        pageLength: 25
      });
    });

    function copyLicense(key) {
      navigator.clipboard.writeText(key).then(() => {
        showToast('Success', 'License key copied to clipboard!', 'success');
      });
    }
  </script>
</body>
</html>
