<div class="app-sidebar sidebar-shadow">
  <div class="app-header__logo">
    <div class="logo-src">
      <i class="pe-7s-shield text-white" style="font-size: 2rem;"></i>
    </div>
    <div class="header__pane ms-auto">
      <button type="button" class="hamburger close-sidebar-btn hamburger--elastic" data-class="closed-sidebar">
        <span class="hamburger-box">
          <span class="hamburger-inner"></span>
        </span>
      </button>
    </div>
  </div>

  <div class="app-header__mobile-menu">
    <button type="button" class="hamburger hamburger--elastic mobile-toggle-nav">
      <span class="hamburger-box">
        <span class="hamburger-inner"></span>
      </span>
    </button>
  </div>

  <div class="scrollbar-sidebar">
    <div class="app-sidebar__inner">
      <ul class="vertical-nav-menu">
        <li class="app-sidebar__heading">MENU</li>

        <li class="<%= title === 'Dashboard' ? 'mm-active' : '' %>">
          <a href="/dashboard">
            <i class="metismenu-icon pe-7s-rocket"></i>
            Dashboard
          </a>
        </li>

        <li class="<%= title.includes('Product') ? 'mm-active' : '' %>">
          <a href="/products">
            <i class="metismenu-icon pe-7s-box2"></i>
            Products
            <i class="metismenu-state-icon pe-7s-angle-down caret-left"></i>
          </a>
        </li>

        <li class="<%= title.includes('Customer') ? 'mm-active' : '' %>">
          <a href="/customers">
            <i class="metismenu-icon pe-7s-users"></i>
            Customers
          </a>
        </li>

        <li class="<%= title.includes('License') ? 'mm-active' : '' %>">
          <a href="/licenses">
            <i class="metismenu-icon pe-7s-key"></i>
            Licenses
          </a>
        </li>

        <li class="app-sidebar__heading">QUICK ACTIONS</li>

        <li>
          <a href="/products/create">
            <i class="metismenu-icon pe-7s-plus"></i>
            New Product
          </a>
        </li>

        <li>
          <a href="/customers/create">
            <i class="metismenu-icon pe-7s-add-user"></i>
            New Customer
          </a>
        </li>

        <li>
          <a href="/licenses/create">
            <i class="metismenu-icon pe-7s-id"></i>
            Generate License
          </a>
        </li>
      </ul>
    </div>
  </div>
</div>
