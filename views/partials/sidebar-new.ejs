<div class="app-sidebar sidebar-shadow">
  <!-- Logo Brand -->
  <div class="app-sidebar__brand">
    <a href="/dashboard" class="d-flex align-items-center text-decoration-none">
      <i class="bi bi-shield-check me-2" style="font-size: 1.5rem; color: white;"></i>
      <span style="color: white; font-weight: 600; font-size: 1.1rem;">License Manager</span>
    </a>
  </div>

  <div class="scrollbar-sidebar">
    <div class="app-sidebar__inner">
      <ul class="vertical-nav-menu">
        <li class="app-sidebar__heading">MENU</li>

        <li class="<%= title === 'Dashboard' ? 'mm-active' : '' %>">
          <a href="/dashboard">
            <i class="metismenu-icon bi bi-speedometer2"></i>
            Dashboard
          </a>
        </li>

        <li class="<%= title.includes('Product') ? 'mm-active' : '' %>">
          <a href="/products">
            <i class="metismenu-icon bi bi-box-seam"></i>
