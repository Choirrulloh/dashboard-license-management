<!-- jQuery -->
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

<!-- Bootstrap Bundle JS -->
<script src="/js/bootstrap.bundle.min.js"></script>

<!-- Chart.js -->
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>

<!-- DataTables JS -->
<script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>

<!-- Custom JS -->
<script src="/js/custom.js"></script>

<!-- ArchitectUI JS -->
<script>
// Mobile menu toggle
document.addEventListener('DOMContentLoaded', function() {
  const mobileToggle = document.querySelector('.mobile-toggle-nav');
  const sidebar = document.querySelector('.app-sidebar');
  const appContainer = document.querySelector('.app-container');

  if (mobileToggle && sidebar) {
    mobileToggle.addEventListener('click', function() {
      sidebar.classList.toggle('sidebar-mobile-open');
    });
  }

  // Close sidebar button
  const closeSidebar = document.querySelector('.close-sidebar-btn');
  if (closeSidebar && appContainer) {
    closeSidebar.addEventListener('click', function() {
      appContainer.classList.toggle('closed-sidebar');
    });
  }

  // Click outside sidebar to close on mobile
  document.addEventListener('click', function(e) {
    if (window.innerWidth < 1200) {
      if (sidebar && sidebar.classList.contains('sidebar-mobile-open')) {
        if (!sidebar.contains(e.target) && !mobileToggle.contains(e.target)) {
          sidebar.classList.remove('sidebar-mobile-open');
        }
      }
    }
  });

  // Initialize Charts (Dashboard)
  const statusCanvas = document.getElementById('licenseStatusChart');
  if (statusCanvas && typeof Chart !== 'undefined') {
    const activeCount = parseInt(statusCanvas.dataset.active || 0);
    const expiredCount = parseInt(statusCanvas.dataset.expired || 0);
    const suspendedCount = parseInt(statusCanvas.dataset.suspended || 0);

    new Chart(statusCanvas.getContext('2d'), {
      type: 'doughnut',
      data: {
        labels: ['Active', 'Expired', 'Suspended'],
        datasets: [{
          data: [activeCount, expiredCount, suspendedCount],
          backgroundColor: ['#16e0bd', '#dc3545', '#98838f'],
          borderWidth: 0
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: {
            position: 'bottom'
          }
        }
      }
    });
  }

  const typeCanvas = document.getElementById('licenseTypeChart');
  if (typeCanvas && typeof Chart !== 'undefined') {
    new Chart(typeCanvas.getContext('2d'), {
      type: 'bar',
      data: {
        labels: ['Trial', 'Monthly', 'Yearly', 'Lifetime'],
        datasets: [{
          label: 'Licenses',
          data: [12, 35, 18, 5],
          backgroundColor: ['#98ce00', '#16e0bd', '#78c3fb', '#89a6fb'],
          borderWidth: 0,
          borderRadius: 8
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: {
            display: false
          }
        },
        scales: {
          y: {
            beginAtZero: true,
            ticks: {
              precision: 0
            }
          }
        }
      }
    });
  }
});
</script>

<!-- Toast Container -->
<div class="toast-container position-fixed bottom-0 end-0 p-3" id="toastContainer"></div>
